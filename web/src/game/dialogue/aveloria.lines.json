    },
    {
        "scene_id":  "C1-08",
        "line_id":  "C1-08-L015",
        "speaker_id":  "C02",
        "spoken_text":  "Untuk sementara, tinggal di kota. Azie akan memeriksa apa yang bisa ditemukan.",
