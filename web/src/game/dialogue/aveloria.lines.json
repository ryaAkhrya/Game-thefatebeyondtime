        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-07",
        "line_id":  "C1-07-L004",
        "speaker_id":  "C01",
        "spoken_text":  "Kurasa aku ingin bertanya hal yang sama.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-07",
        "line_id":  "C1-07-L005",
        "speaker_id":  "C05",
        "spoken_text":  "Ada warga yang yakin kejadian ini berhubungan dengan cerita lama. Mereka menyebutnya The Fate.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C05_Azie/C05_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-07",
        "line_id":  "C1-07-L006",
        "speaker_id":  "C01",
        "spoken_text":  "Itu nama penyakit?",
        "emotion_id":  "CONFUSED",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-07",
        "line_id":  "C1-07-L007",
        "speaker_id":  "C05",
        "spoken_text":  "Menurut sebagian orang, kutukan. Menurut yang lain, makhluk. Tidak ada laporan yang sepakat.",
