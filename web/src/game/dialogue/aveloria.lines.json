        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-07",
        "line_id":  "C1-07-L010",
        "speaker_id":  "C06",
        "spoken_text":  "Ratu meminta diberi tahu jika ada orang lain yang kehilangan ingatan.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C06_Talric/C06_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-07",
        "line_id":  "C1-07-L011",
        "speaker_id":  "C05",
        "spoken_text":  "Kalau begitu, kita laporkan yang kita tahu. Bukan sisanya.",
