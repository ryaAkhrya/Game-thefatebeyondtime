        "line_id":  "C1-06-L010",
        "speaker_id":  "C01",
        "spoken_text":  "Jawaban yang ada.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-06",
        "line_id":  "C1-06-L011",
        "speaker_id":  "C06",
        "spoken_text":  "Beberapa orang kembali dari hutan dengan ingatan yang tidak utuh. Kau bukan yang pertama.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C06_Talric/C06_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-06",
        "line_id":  "C1-06-L012",
        "speaker_id":  "C01",
        "spoken_text":  "Ada yang sembuh?",
        "emotion_id":  "CONFUSED",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-06",
        "line_id":  "C1-06-L013",
        "speaker_id":  "C06",
        "spoken_text":  "Aku bukan tabib. Ikut. Kau akan bicara dengan orang yang menyimpan laporannya.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C06_Talric/C06_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-07",
        "line_id":  "C1-07-L001",
        "speaker_id":  "C05",
        "spoken_text":  "Kalau ini laporan yang ketiga hari ini, tulisannya sudah mulai lebih buruk daripada isinya.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C05_Azie/C05_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-07",
        "line_id":  "C1-07-L002",
        "speaker_id":  "C06",
        "spoken_text":  "Orang dari hutan. Tidak ingat siapa dirinya.",
        "emotion_id":  "SUSPICIOUS",
