        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_I_SCRIPT.md"
    },
    {
        "scene_id":  "C1-06",
        "line_id":  "C1-06-L009",
        "speaker_id":  "C06",
        "spoken_text":  "Jawaban macam apa itu?",
