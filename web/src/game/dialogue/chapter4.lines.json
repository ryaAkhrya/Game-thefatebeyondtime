[
  {
    "scene_id": "C4-01",
    "line_id": "C4-01-L001",
    "speaker_id": "C01",
    "spoken_text": "Kalau kita gagal, masih ada yang menjaga kota?",
    "emotion_id": "CONFUSED",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-01",
    "line_id": "C4-01-L002",
    "speaker_id": "C02",
    "spoken_text": "Talric. Dan Azie, kalau dia berhenti membantah perintahku.",
    "emotion_id": "STERN",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_STERN.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-01",
    "line_id": "C4-01-L003",
    "speaker_id": "C01",
    "spoken_text": "Itu terdengar sulit.",
    "emotion_id": "NEUTRAL",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-01",
    "line_id": "C4-01-L004",
    "speaker_id": "C02",
    "spoken_text": "Lebih sulit menyuruhmu membaca peta.",
    "emotion_id": "NEUTRAL",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_NEUTRAL.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-02",
    "line_id": "C4-02-L001",
    "speaker_id": "C04",
    "spoken_text": "Aku melihat ini sebelum kalian datang. Menara jatuh. Warga mati ketakutan. Dan setiap petunjuk mengarah pada The Fate.",
    "emotion_id": "ANGRY",
    "portrait_asset_path": "assets/characters/C04_Varlgrim/C04_EXPRESSION_ANGRY.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-02",
    "line_id": "C4-02-L002",
    "speaker_id": "C02",
    "spoken_text": "Aku melihat kerusakan yang sama. Tapi semuanya dimulai di tempat kau memasang segel.",
    "emotion_id": "STERN",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_STERN.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-02",
    "line_id": "C4-02-L003",
    "speaker_id": "C04",
    "spoken_text": "Segel itu satu-satunya alasan kita masih berdiri.",
    "emotion_id": "STERN",
    "portrait_asset_path": "assets/characters/C04_Varlgrim/C04_EXPRESSION_STERN.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-02",
    "line_id": "C4-02-L004",
    "speaker_id": "C01",
    "spoken_text": "Kau pernah mempertimbangkan kalau kau salah?",
    "emotion_id": "DETERMINED",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_DETERMINED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-02",
    "line_id": "C4-02-L005",
    "speaker_id": "C04",
    "spoken_text": "Aku pernah salah. Dan seseorang tidak kembali. Aku tak akan mengulanginya.",
    "emotion_id": "REMORSE",
    "portrait_asset_path": "assets/characters/C04_Varlgrim/C04_EXPRESSION_REMORSE.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-02",
    "line_id": "C4-02-L006",
    "speaker_id": "C02",
    "spoken_text": "Dengan cara ini, kau sedang mengulanginya.",
    "emotion_id": "ANGRY",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_ANGRY.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-03",
    "line_id": "C4-03-L001",
    "speaker_id": "C04",
    "spoken_text": "Kalau segelnya kulepas...",
    "emotion_id": "REMORSE",
    "portrait_asset_path": "assets/characters/C04_Varlgrim/C04_EXPRESSION_REMORSE.png",
    "pause_ms": 550
  },
  {
    "scene_id": "C4-03",
    "line_id": "C4-03-L002",
    "speaker_id": "C02",
    "spoken_text": "Kami akan menanggung akibatnya. Aku juga. Tapi rakyatku sudah dievakuasi. Sekarang lihat buktinya.",
    "emotion_id": "STERN",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_STERN.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-04",
    "line_id": "C4-04-L001",
    "speaker_id": "C01",
    "spoken_text": "Menaranya...",
    "emotion_id": "SURPRISED",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_SURPRISED.png",
    "pause_ms": 550
  },
  {
    "scene_id": "C4-04",
    "line_id": "C4-04-L002",
    "speaker_id": "C02",
    "spoken_text": "Aku tahu. Orang-orang sudah di luar kota tua. Talric mengabariku tadi.",
    "emotion_id": "WORRIED",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_WORRIED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-04",
    "line_id": "C4-04-L003",
    "speaker_id": "C01",
    "spoken_text": "Nggak semuanya bisa diselamatkan.",
    "emotion_id": "SAD",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_SAD.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-04",
    "line_id": "C4-04-L004",
    "speaker_id": "C02",
    "spoken_text": "Tidak. Tapi kita tidak harus membiarkan sisanya hilang juga.",
    "emotion_id": "STERN",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_STERN.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-05",
    "line_id": "C4-05-L001",
    "speaker_id": "C01",
    "spoken_text": "Aku ingat. Kita pernah berdiri di sini.",
    "emotion_id": "SURPRISED",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_SURPRISED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-05",
    "line_id": "C4-05-L002",
    "speaker_id": "C02",
    "spoken_text": "Dan waktu itu kau bilang kau tahu jalan pulang.",
    "emotion_id": "VULNERABLE",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_VULNERABLE.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-05",
    "line_id": "C4-05-L003",
    "speaker_id": "C01",
    "spoken_text": "Kayaknya itu memang kebohongan paling burukku.",
    "emotion_id": "EMBARRASSED",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_EMBARRASSED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-05",
    "line_id": "C4-05-L004",
    "speaker_id": "C02",
    "spoken_text": "Kau memang tidak pandai mencari jalan.",
    "emotion_id": "AMUSED",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_AMUSED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-06",
    "line_id": "C4-06-L001",
    "speaker_id": "C04",
    "spoken_text": "Aku... melihat akhirnya. Bukan awalnya.",
    "emotion_id": "REMORSE",
    "portrait_asset_path": "assets/characters/C04_Varlgrim/C04_EXPRESSION_REMORSE.png",
    "pause_ms": 550
  },
  {
    "scene_id": "C4-06",
    "line_id": "C4-06-L002",
    "speaker_id": "C02",
    "spoken_text": "Aku tidak bisa menganggap semuanya selesai begitu kau mengerti.",
    "emotion_id": "VULNERABLE",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_VULNERABLE.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-06",
    "line_id": "C4-06-L003",
    "speaker_id": "C04",
    "spoken_text": "Aku tidak memintanya. Masih ada retakan yang perlu ditahan.",
    "emotion_id": "DETERMINED",
    "portrait_asset_path": "assets/characters/C04_Varlgrim/C04_EXPRESSION_DETERMINED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-06",
    "line_id": "C4-06-L004",
    "speaker_id": "C03",
    "spoken_text": "Kalian berhasil juga. Aku sempat khawatir.",
    "emotion_id": "SOLEMN",
    "portrait_asset_path": "assets/characters/C03_Torvan/C03_EXPRESSION_SOLEMN.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-06",
    "line_id": "C4-06-L005",
    "speaker_id": "C01",
    "spoken_text": "Sejak kapan kau ada di sini?",
    "emotion_id": "CONFUSED",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-06",
    "line_id": "C4-06-L006",
    "speaker_id": "C03",
    "spoken_text": "Cukup lama untuk melihat kalian membuat pilihan sendiri.",
    "emotion_id": "SOLEMN",
    "portrait_asset_path": "assets/characters/C03_Torvan/C03_EXPRESSION_SOLEMN.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-06",
    "line_id": "C4-06-L007",
    "speaker_id": "C02",
    "spoken_text": "Torvan. Sebenarnya kau siapa?",
    "emotion_id": "SURPRISED",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_SURPRISED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-06",
    "line_id": "C4-06-L008",
    "speaker_id": "C03",
    "spoken_text": "Aku yang membuat dunia ini dulu. Tapi bukan aku yang menentukan apa yang harus kalian lakukan di dalamnya.",
    "emotion_id": "DETERMINED",
    "portrait_asset_path": "assets/characters/C03_Torvan/C03_EXPRESSION_DETERMINED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-06",
    "line_id": "C4-06-L009",
    "speaker_id": "C01",
    "spoken_text": "Itu... penjelasan yang terlalu tenang.",
    "emotion_id": "SURPRISED",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_SURPRISED.png",
    "pause_ms": 550
  },
  {
    "scene_id": "C4-06",
    "line_id": "C4-06-L010",
    "speaker_id": "C03",
    "spoken_text": "Aku sudah lama berlatih.",
    "emotion_id": "MISCHIEVOUS",
    "portrait_asset_path": "assets/characters/C03_Torvan/C03_EXPRESSION_MISCHIEVOUS.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-07",
    "line_id": "C4-07-L001",
    "speaker_id": "C06",
    "spoken_text": "Warga di kota tua sudah kami pindahkan. Bangunannya... tidak semuanya bertahan.",
    "emotion_id": "NEUTRAL",
    "portrait_asset_path": "assets/characters/C06_Talric/C06_EXPRESSION_NEUTRAL.png",
    "pause_ms": 550
  },
  {
    "scene_id": "C4-07",
    "line_id": "C4-07-L002",
    "speaker_id": "C02",
    "spoken_text": "Kita mulai perbaikan besok. Malam ini pastikan tak ada yang tertinggal.",
    "emotion_id": "NEUTRAL",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_NEUTRAL.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-07",
    "line_id": "C4-07-L003",
    "speaker_id": "C01",
    "spoken_text": "Kau masih punya banyak pekerjaan.",
    "emotion_id": "NEUTRAL",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-07",
    "line_id": "C4-07-L004",
    "speaker_id": "C02",
    "spoken_text": "Punya.",
    "emotion_id": "NEUTRAL",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_NEUTRAL.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-07",
    "line_id": "C4-07-L005",
    "speaker_id": "C01",
    "spoken_text": "Boleh aku membantu? Aku mungkin salah jalan sekali dua kali.",
    "emotion_id": "CONFUSED",
    "portrait_asset_path": "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
    "pause_ms": 250
  },
  {
    "scene_id": "C4-07",
    "line_id": "C4-07-L006",
    "speaker_id": "C02",
    "spoken_text": "Kalau cuma dua kali, itu kemajuan.",
    "emotion_id": "NEUTRAL",
    "portrait_asset_path": "assets/characters/C02_Velthia/C02_EXPRESSION_NEUTRAL.png",
    "pause_ms": 250
  }
]
