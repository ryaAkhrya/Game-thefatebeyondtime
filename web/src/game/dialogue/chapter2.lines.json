        "line_id":  "C2-04-L001",
        "speaker_id":  "C01",
        "spoken_text":  "Tunggu. Bayangan itu...",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
