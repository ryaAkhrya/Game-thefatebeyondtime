        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L014",
        "speaker_id":  "C07",
        "spoken_text":  "Hutan di luar desa masih punya sisa penanda lama. Kalau ada jawaban, mungkin bukan di mulutku.",
