[
    {
        "scene_id":  "C2-01",
        "line_id":  "C2-01-L001",
        "speaker_id":  "C05",
        "spoken_text":  "Aku menemukan nama desa yang muncul dalam dua versi cerita.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C05_Azie/C05_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
