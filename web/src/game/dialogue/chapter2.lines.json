    },
    {
        "scene_id":  "C2-01",
        "line_id":  "C2-01-L002",
        "speaker_id":  "C01",
        "spoken_text":  "Bagus atau buruk?",
        "emotion_id":  "CONFUSED",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-01",
        "line_id":  "C2-01-L003",
        "speaker_id":  "C05",
        "spoken_text":  "Tergantung kau suka jawaban yang rapi atau tidak.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C05_Azie/C05_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-01",
        "line_id":  "C2-01-L004",
        "speaker_id":  "C01",
        "spoken_text":  "Aku mulai curiga tidak ada jawaban rapi di kota ini.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-01",
        "line_id":  "C2-01-L005",
        "speaker_id":  "C05",
        "spoken_text":  "Yang satu menyebut The Fate membawa bencana. Yang lain menyebutnya sesuatu yang hilang.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C05_Azie/C05_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-01",
        "line_id":  "C2-01-L006",
        "speaker_id":  "C01",
        "spoken_text":  "Hilang?",
        "emotion_id":  "CONFUSED",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-01",
        "line_id":  "C2-01-L007",
        "speaker_id":  "C05",
        "spoken_text":  "Bagian sisanya rusak. Salinan yang lebih tua katanya disimpan di Liora.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C05_Azie/C05_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-01",
        "line_id":  "C2-01-L008",
        "speaker_id":  "C01",
        "spoken_text":  "Jadi aku harus menemui orang yang menyimpan kertas yang tidak rusak.",
        "emotion_id":  "DETERMINED",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_DETERMINED.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-01",
        "line_id":  "C2-01-L009",
        "speaker_id":  "C05",
        "spoken_text":  "Kurang lebih. Tapi tanyakan dari mana cerita itu berasal, jangan cuma isinya.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C05_Azie/C05_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-01",
        "line_id":  "C2-01-L010",
        "speaker_id":  "C05",
        "spoken_text":  "Jangan perlakukan salah satunya sebagai kebenaran hanya karena lebih menyeramkan.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C05_Azie/C05_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L001",
        "speaker_id":  "C02",
        "spoken_text":  "Azie bilang kau menuju Liora.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C02_Velthia/C02_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L002",
        "speaker_id":  "C01",
        "spoken_text":  "Kau terdengar seperti sudah tahu aku akan tersesat.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L003",
        "speaker_id":  "C02",
        "spoken_text":  "Aku belum mengatakan itu.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C02_Velthia/C02_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L004",
        "speaker_id":  "C01",
        "spoken_text":  "Tapi kau memikirkannya.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L005",
        "speaker_id":  "C02",
        "spoken_text":  "Sedikit.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C02_Velthia/C02_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L006",
        "speaker_id":  "C02",
        "spoken_text":  "Tunjukkan ini pada penjaga desa. Mereka sedang waspada terhadap orang luar.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C02_Velthia/C02_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L007",
        "speaker_id":  "C01",
        "spoken_text":  "Kau menyiapkannya sendiri?",
        "emotion_id":  "SAD",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_SAD.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L008",
        "speaker_id":  "C02",
        "spoken_text":  "Aku menandatanganinya sendiri. Menyiapkan segel dan kertasnya pekerjaan Azie.",
