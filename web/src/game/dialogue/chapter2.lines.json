        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L002",
        "speaker_id":  "C01",
        "spoken_text":  "Aku belum menyentuhnya.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L003",
        "speaker_id":  "C07",
        "spoken_text":  "Kau sedang mempertimbangkan.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C07_Zira/C07_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L004",
        "speaker_id":  "C01",
        "spoken_text":  "Baiklah. Aku datang dari Aveloria. Mencari cerita tentang The Fate.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L005",
        "speaker_id":  "C07",
        "spoken_text":  "Di sini ceritanya tidak selalu sama dengan yang dibacakan orang kota.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C07_Zira/C07_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L006",
        "speaker_id":  "C01",
        "spoken_text":  "Mana yang benar?",
        "emotion_id":  "CONFUSED",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L007",
        "speaker_id":  "C07",
        "spoken_text":  "Kalau aku tahu, aku tidak akan menyimpan dua ukiran.",
