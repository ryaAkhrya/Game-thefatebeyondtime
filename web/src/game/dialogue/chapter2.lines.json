        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L009",
        "speaker_id":  "C01",
        "spoken_text":  "Tetap saja. Terima kasih.",
        "emotion_id":  "HAPPY",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_HAPPY.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L010",
        "speaker_id":  "C02",
        "spoken_text":  "Pulanglah membawa jawaban. Bukan luka baru.",
