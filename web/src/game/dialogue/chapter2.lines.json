        "portrait_asset_path":  "assets/characters/C02_Velthia/C02_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L011",
        "speaker_id":  "C01",
        "spoken_text":  "Aku usahakan keduanya tidak tertukar.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-02",
        "line_id":  "C2-02-L012",
        "speaker_id":  "C02",
        "spoken_text":  "Itu permintaan yang cukup sederhana.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C02_Velthia/C02_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L001",
        "speaker_id":  "C07",
        "spoken_text":  "Kalau mau bertanya soal ukiran itu, tanganmu jauhkan dulu dari sisi yang rapuh.",
