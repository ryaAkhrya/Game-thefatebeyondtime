        "portrait_asset_path":  "assets/characters/C07_Zira/C07_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L008",
        "speaker_id":  "C01",
        "spoken_text":  "Yang satu?",
        "emotion_id":  "CONFUSED",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L009",
        "speaker_id":  "C07",
        "spoken_text":  "Ada yang mengingat bencana. Ada yang mengingat dua orang yang berusaha pulang.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C07_Zira/C07_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L010",
        "speaker_id":  "C01",
        "spoken_text":  "Dua orang?",
        "emotion_id":  "CONFUSED",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L011",
        "speaker_id":  "C07",
        "spoken_text":  "Bukan berarti sepasang kekasih, kalau itu yang langsung kau pikir.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C07_Zira/C07_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L012",
        "speaker_id":  "C01",
        "spoken_text":  "Aku belum berpikir apa-apa.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
