        "portrait_asset_path":  "assets/characters/C07_Zira/C07_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L015",
        "speaker_id":  "C01",
        "spoken_text":  "Kau tidak ikut?",
        "emotion_id":  "CONFUSED",
        "portrait_asset_path":  "assets/characters/C01_Yaric/C01_EXPRESSION_CONFUSED.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
        "scene_id":  "C2-03",
        "line_id":  "C2-03-L016",
        "speaker_id":  "C07",
        "spoken_text":  "Punggungku sudah cukup berperang dengan kursi ini.",
        "emotion_id":  "NEUTRAL",
        "portrait_asset_path":  "assets/characters/C07_Zira/C07_EXPRESSION_NEUTRAL.png",
        "sprite_pose":  "idle",
        "pause_ms":  250,
        "note":  "DRAFT dialogue; expression choice editorial, review in context",
        "source_script":  "CHAPTER_II_SCRIPT.md"
    },
    {
